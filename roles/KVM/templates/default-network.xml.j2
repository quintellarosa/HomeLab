<network>
  <name>{{ kvm_default_network_name }}</name>
  <forward mode='nat'>
    <nat>
      <port start='1024' end='65535'/>
    </nat>
  </forward>
  <bridge name='{{ kvm_default_network_bridge }}' stp='on' delay='0'/>
  <ip address='{{ kvm_default_network_gateway }}' netmask='{{ kvm_default_network_netmask }}'>
{% if (kvm_default_network_dhcp | bool) and (kvm_default_network_dhcp_start | length > 0) and (kvm_default_network_dhcp_end | length > 0) %}
    <dhcp>
      <range start='{{ kvm_default_network_dhcp_start }}' end='{{ kvm_default_network_dhcp_end }}'/>
    </dhcp>
{% endif %}
  </ip>
</network>
