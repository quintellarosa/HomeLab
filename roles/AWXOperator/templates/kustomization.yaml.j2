---
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
namespace: {{ awx_operator_namespace }}
resources:
  - github.com/ansible/awx-operator/config/default?ref={{ awx_operator_version }}
images:
  - name: {{ awx_operator_image }}
    newTag: "{{ awx_operator_version }}"
  - name: gcr.io/kubebuilder/kube-rbac-proxy
    newName: {{ awx_operator_rbac_proxy_image }}
    newTag: "{{ awx_operator_rbac_proxy_tag }}"
