---
ipam:
  mode: {{ cilium_ipam_mode }}
{% if cilium_ipam_mode == 'cluster-pool' %}
  operator:
    clusterPoolIPv4PodCIDRList:
      - "{{ cilium_cluster_pool_ipv4_cidr }}"
    clusterPoolIPv4MaskSize: {{ cilium_cluster_pool_ipv4_mask_size }}
{% endif %}
routingMode: {{ cilium_routing_mode }}
tunnelProtocol: {{ cilium_tunnel_protocol }}
kubeProxyReplacement: {{ cilium_kube_proxy_replacement | bool | lower }}
operator:
  replicas: {{ cilium_operator_replicas }}
hubble:
  enabled: {{ cilium_hubble_enabled | bool | lower }}
  relay:
    enabled: {{ (cilium_hubble_enabled and cilium_hubble_relay_enabled) | bool | lower }}
  ui:
    enabled: {{ (cilium_hubble_enabled and cilium_hubble_ui_enabled) | bool | lower }}
