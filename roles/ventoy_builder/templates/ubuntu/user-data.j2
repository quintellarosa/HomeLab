#cloud-config
# Generated by HomeLab Ansible (profile={{ disk_profile }}, distro={{ target_distro }})

# Ensure Subiquity enters non-interactive autoinstall even if the kernel cmdline lacked 'autoinstall'
bootcmd:
  - [ sh, -c, "if ! grep -qw autoinstall /proc/cmdline; then cp /proc/cmdline /tmp/homelab-cmdline && sed -i 's/$/ autoinstall/' /tmp/homelab-cmdline && mount -n --bind -o ro /tmp/homelab-cmdline /proc/cmdline; fi" ]

autoinstall:
  version: 1
  source:
    id: {{ ubuntu_desktop_source }}

  locale: {{ target_locale }}
  timezone: {{ target_timezone }}
  keyboard:
    layout: {{ target_keyboard_layout }}
{% if target_keyboard_variant | length > 0 %}
    variant: {{ target_keyboard_variant }}
{% endif %}

  identity:
    hostname: {{ target_hostname }}
    realname: {{ target_gecos }}
    username: {{ target_user }}
    password: "{{ user_password_hash }}"

  ssh:
    install-server: true
    allow-pw: true
{% if ssh_authorized_keys | length > 0 %}
    authorized-keys:
{% for key in ssh_authorized_keys %}
      - "{{ key }}"
{% endfor %}
{% endif %}

  updates: security

  network:
    version: 2
    renderer: NetworkManager
    ethernets:
      all-en:
        match:
          name: "en*"
        dhcp4: true
        optional: true
{% set _wifi_ns = namespace(nets=[]) %}
{% for net in (wifi_networks | default([])) %}
{%   if (net.ssid | default('') | length > 0) and (net.password | default('') | length > 0) %}
{%     set _wifi_ns.nets = _wifi_ns.nets + [net] %}
{%   endif %}
{% endfor %}
{% if (wifi_ssid | default('') | length > 0) and (wifi_password | default('') | length > 0) and (wifi_ssid not in (_wifi_ns.nets | map(attribute='ssid') | list)) %}
{%   set _wifi_ns.nets = _wifi_ns.nets + [{'ssid': wifi_ssid, 'password': wifi_password}] %}
{% endif %}
{% if _wifi_ns.nets | length > 0 %}
    wifis:
      all-wl:
        match:
          name: "wl*"
        dhcp4: true
        optional: true
        access-points:
{% for net in _wifi_ns.nets %}
          {{ net.ssid | to_json }}:
            password: {{ net.password | to_json }}
{% endfor %}
{% endif %}

  # Fail-closed disk verification before Curtin touches any block device
  early-commands:
    - |
      set -eu
      echo "=== HomeLab pre-flight disk check ({{ disk_profile }}) ==="

      OS_SERIAL="{{ active_disk_profile.os_disk_serial }}"
      HOME_UUID="{{ active_disk_profile.home_fs_uuid }}"
      HOME_LABEL="{{ active_disk_profile.home_fs_label }}"
      HOME_FSTYPE="{{ active_disk_profile.home_fs_type }}"

      OS_DISK=$(lsblk -ndo PATH,SERIAL | awk -v s="$OS_SERIAL" '$2 == s { print $1; exit }')
      if [ -z "${OS_DISK:-}" ] || [ ! -b "$OS_DISK" ]; then
        echo "FATAL: Target OS disk with serial '$OS_SERIAL' not found!" >&2
        exit 1
      fi
      echo "Found OS target disk: $OS_DISK (serial=$OS_SERIAL)"

      HOME_PART=""
      if [ -n "$HOME_UUID" ]; then
        HOME_PART=$(blkid -U "$HOME_UUID" || true)
      elif [ -n "$HOME_LABEL" ]; then
        HOME_PART=$(blkid -L "$HOME_LABEL" || true)
      fi
      if [ -z "${HOME_PART:-}" ] || [ ! -b "$HOME_PART" ]; then
        echo "FATAL: Existing /home partition (uuid='$HOME_UUID', label='$HOME_LABEL') not found!" >&2
        exit 1
      fi

      ACTUAL_FSTYPE=$(lsblk -no FSTYPE "$HOME_PART" | head -n1)
      if [ "$ACTUAL_FSTYPE" != "$HOME_FSTYPE" ]; then
        echo "FATAL: /home partition $HOME_PART has fstype '$ACTUAL_FSTYPE', expected '$HOME_FSTYPE'!" >&2
        exit 1
      fi

      HOME_PKNAME=$(lsblk -no PKNAME "$HOME_PART" | head -n1 || true)
      if [ -n "$HOME_PKNAME" ]; then
        HOME_PARENT="/dev/$HOME_PKNAME"
      else
        HOME_PARENT="$HOME_PART"
      fi
      if [ "$HOME_PARENT" = "$OS_DISK" ]; then
        echo "FATAL: /home partition $HOME_PART resides on OS target disk $OS_DISK! Aborting." >&2
        exit 1
      fi
      echo "Verified /home partition: $HOME_PART on $HOME_PARENT (fstype=$ACTUAL_FSTYPE)"

{% for pserial in active_disk_profile.protected_disk_serials %}
      PROT_DISK=$(lsblk -ndo PATH,SERIAL | awk -v s="{{ pserial }}" '$2 == s { print $1; exit }')
      if [ -n "${PROT_DISK:-}" ] && [ "$PROT_DISK" = "$OS_DISK" ]; then
        echo "FATAL: OS target disk $OS_DISK matches protected serial {{ pserial }}! Aborting." >&2
        exit 1
      fi
{% endfor %}
      echo "=== Pre-flight checks passed ==="

  # Only the OS target disk is declared to Curtin; /home and Windows disks are never touched by Curtin
  storage:
    layout:
      name: none
    config:
      - id: os-disk
        type: disk
        match:
          serial: "{{ active_disk_profile.os_disk_serial }}"
        ptable: gpt
        wipe: superblock-recursive
        preserve: false
        grub_device: true
      - id: efi-part
        type: partition
        device: os-disk
        size: 1G
        flag: boot
        grub_device: true
        preserve: false
      - id: efi-fs
        type: format
        volume: efi-part
        fstype: fat32
        preserve: false
      - id: efi-mount
        type: mount
        device: efi-fs
        path: /boot/efi
      - id: root-part
        type: partition
        device: os-disk
        size: -1
        preserve: false
      - id: root-fs
        type: format
        volume: root-part
        fstype: ext4
        preserve: false
      - id: root-mount
        type: mount
        device: root-fs
        path: /

  late-commands:
    # 1. Enforce exact UID/GID 1000 for cross-distro /home ownership consistency
    - |
      set -eu
      curtin in-target --target=/target -- usermod -u {{ target_uid }} {{ target_user }}
      curtin in-target --target=/target -- groupmod -g {{ target_gid }} {{ target_user }}

    # 2. Wire preserved /home partition into /etc/fstab by UUID and seed home dir only if absent
    - |
      set -eu
      HOME_UUID="{{ active_disk_profile.home_fs_uuid }}"
      HOME_LABEL="{{ active_disk_profile.home_fs_label }}"
      if [ -n "$HOME_UUID" ]; then
        HOME_PART=$(blkid -U "$HOME_UUID")
      else
        HOME_PART=$(blkid -L "$HOME_LABEL")
        HOME_UUID=$(blkid -s UUID -o value "$HOME_PART")
      fi
      mkdir -p /mnt/homelab-home
      mount "$HOME_PART" /mnt/homelab-home
      HOME_USER_DIR="/mnt/homelab-home/{{ target_user }}"
      if [ ! -d "$HOME_USER_DIR" ]; then
        mkdir -p "$HOME_USER_DIR"
        cp -a /target/etc/skel/. "$HOME_USER_DIR/"
        chown -R {{ target_uid }}:{{ target_gid }} "$HOME_USER_DIR"
      fi
{% if desktop_skip_welcome_wizard | bool %}
      mkdir -p "$HOME_USER_DIR/.config/gnome-initial-setup"
      printf 'yes\n' > "$HOME_USER_DIR/.config/gnome-initial-setup-done"
      printf 'yes\n' > "$HOME_USER_DIR/.config/gnome-initial-setup/upgrade-{{ active_distro.version }}-done"
      chown -R {{ target_uid }}:{{ target_gid }} \
        "$HOME_USER_DIR/.config" \
        "$HOME_USER_DIR/.config/gnome-initial-setup-done" \
        "$HOME_USER_DIR/.config/gnome-initial-setup"
{% endif %}
{% if desktop_share_system_data | bool %}
      mkdir -p "$HOME_USER_DIR/.config/ubuntu-insights"
      for name in linux ubuntu_desktop_provision ubuntu_release_upgrader; do
        printf 'consent_state = true\n' > "$HOME_USER_DIR/.config/ubuntu-insights/${name}-consent.toml"
      done
      chown -R {{ target_uid }}:{{ target_gid }} "$HOME_USER_DIR/.config/ubuntu-insights"
{% endif %}
{% if user_avatar_slurp.content is defined %}
      printf '%s' '{{ user_avatar_slurp.content }}' | base64 -d > "$HOME_USER_DIR/.face"
      chown {{ target_uid }}:{{ target_gid }} "$HOME_USER_DIR/.face"
      chmod 0644 "$HOME_USER_DIR/.face"
{% endif %}
      umount /mnt/homelab-home
      rmdir /mnt/homelab-home
      rm -rf "/target/home/{{ target_user }}"
      grep -q "UUID=$HOME_UUID" /target/etc/fstab || \
        echo "UUID=$HOME_UUID /home {{ active_disk_profile.home_fs_type }} {{ active_disk_profile.home_mount_options }} 0 1" >> /target/etc/fstab

    # 3. Install bootstrap packages (including universe/ansible) and GitHub CLI (gh)
    - |
      curtin in-target --target=/target -- bash -c '
        set -euo pipefail
        export DEBIAN_FRONTEND=noninteractive
        if [ -f /etc/apt/sources.list.d/ubuntu.sources ] && ! grep -q "universe" /etc/apt/sources.list.d/ubuntu.sources; then
          sed -i "s/^Components:.*/& universe/" /etc/apt/sources.list.d/ubuntu.sources
        fi
        apt-get update
        apt-get install -y {{ bootstrap_packages | join(" ") }}
        if apt-cache show gh >/dev/null 2>&1; then
          apt-get install -y gh
        else
          mkdir -p -m 755 /etc/apt/keyrings
          curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | tee /etc/apt/keyrings/githubcli-archive-keyring.gpg >/dev/null
          chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg
          echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list
          apt-get update
          apt-get install -y gh
        fi
      '

{% if install_nvidia_if_present | bool %}
    # 4. Install NVIDIA proprietary drivers only when an NVIDIA GPU is present
    - |
      if grep -qi '0x10de' /sys/bus/pci/devices/*/vendor 2>/dev/null; then
        curtin in-target --target=/target -- ubuntu-drivers autoinstall
      fi
{% endif %}

    # 5. Apply system-wide GNOME & Ubuntu Dock defaults via dconf
    - |
      set -eu
      mkdir -p /target/etc/dconf/profile /target/etc/dconf/db/local.d
      if [ ! -f /target/etc/dconf/profile/user ]; then
        printf 'user-db:user\nsystem-db:local\n' > /target/etc/dconf/profile/user
      elif ! grep -qx 'system-db:local' /target/etc/dconf/profile/user; then
        printf '\nsystem-db:local\n' >> /target/etc/dconf/profile/user
      fi
      {
{% if desktop_dark_mode | bool %}
        printf "[org/gnome/desktop/interface]\ncolor-scheme='prefer-dark'\ngtk-theme='Yaru-dark'\n\n"
{% endif %}
{% if desktop_location_services | bool %}
        printf "[org/gnome/system/location]\nenabled=true\n\n"
{% endif %}
        printf "[org/gnome/shell/extensions/dash-to-dock]\ndock-position='{{ desktop_dock_position }}'\ndash-max-icon-size={{ desktop_dock_icon_size }}\nextend-height={{ 'true' if (desktop_dock_extend_height | bool) else 'false' }}\nshow-mounts={{ 'true' if (desktop_dock_show_mounts | bool) else 'false' }}\nshow-trash={{ 'true' if (desktop_dock_show_trash | bool) else 'false' }}\n\n"
        printf "[org/gnome/shell/extensions/ding]\nicon-size='{{ desktop_icons_size }}'\nstart-corner='{{ desktop_icons_start_corner }}'\nshow-home={{ 'true' if (desktop_icons_show_home | bool) else 'false' }}\n\n"
        printf "[org/gnome/desktop/input-sources]\nsources=[{{ desktop_input_sources | join(', ') }}]\n"
      } > /target/etc/dconf/db/local.d/00-homelab
      curtin in-target --target=/target -- dconf update
      chmod -R a+rX /target/etc/dconf

{% if desktop_share_error_reports | bool %}
    # 6. Enable error/metrics reporting (whoopsie + apport)
    - |
      set -eu
      printf '[General]\nreport_metrics=true\n' > /target/etc/whoopsie
      if [ -f /target/etc/default/apport ]; then
        sed -i 's/^enabled=.*/enabled=1/' /target/etc/default/apport
        grep -q '^enabled=' /target/etc/default/apport || printf 'enabled=1\n' >> /target/etc/default/apport
      fi
{% endif %}

{% if user_avatar_slurp.content is defined %}
    # 7. Assign user avatar icon in AccountsService
    - |
      set -eu
      mkdir -p /target/var/lib/AccountsService/icons /target/var/lib/AccountsService/users
      printf '%s' '{{ user_avatar_slurp.content }}' | base64 -d > "/target/var/lib/AccountsService/icons/{{ target_user }}"
      chmod 0644 "/target/var/lib/AccountsService/icons/{{ target_user }}"
      AS_USER="/target/var/lib/AccountsService/users/{{ target_user }}"
      if [ -f "$AS_USER" ] && grep -q '^\[User\]' "$AS_USER"; then
        awk -v icon="/var/lib/AccountsService/icons/{{ target_user }}" '
          /^Icon=/ { next }
          /^\[User\]/ { print; print "Icon=" icon; next }
          { print }
        ' "$AS_USER" > "${AS_USER}.tmp" && mv "${AS_USER}.tmp" "$AS_USER"
      else
        printf '[User]\nIcon=/var/lib/AccountsService/icons/{{ target_user }}\nSystemAccount=false\n' > "$AS_USER"
      fi
      chmod 0644 "$AS_USER"
{% endif %}

{% if bluetooth_archive_slurp.content is defined %}
    # 8. Restore pre-paired Bluetooth devices (/var/lib/bluetooth)
    - |
      set -eu
      mkdir -p /target/var/lib/bluetooth
      printf '%s' '{{ bluetooth_archive_slurp.content }}' | base64 -d | tar -C /target/var/lib/bluetooth -xzf -
      chown -R root:root /target/var/lib/bluetooth
      chmod 0700 /target/var/lib/bluetooth
{% endif %}
