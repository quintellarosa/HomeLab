---
# Copy this file to group_vars/secrets.yml (gitignored) and populate real values.
# Generate a SHA-512 password hash with:
#   openssl passwd -6 'your-password'

user_password_hash: "$6$rounds=4096$replaceme$replacewithrealopensslpasswd6hash"

ssh_authorized_keys:
  - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... user@host"

# Optional Wi-Fi networks to auto-connect during install and on first boot
wifi_networks:
  - ssid: "MyHomeWiFi"
    password: "replace-with-wifi-password"
  - ssid: "MyPhoneHotspot"
    password: "replace-with-hotspot-password"
