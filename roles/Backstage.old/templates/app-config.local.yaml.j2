app:
  title: Backstage
  baseUrl: "http://{{ ansible_facts['default_ipv4']['address'] }}:{{ backstage.frontend.port }}"

backend:
  baseUrl: "http://{{ ansible_facts['default_ipv4']['address'] }}:{{ backstage.backend.port }}"
  listen:
    port: {{ backstage.backend.port }}
  database:
    client: pg
    connection:
      host: "{{ backstage.database.host }}"
      port: {{ backstage.database.port }}
      user: "{{ backstage.database.user }}"
      password: "{{ backstage.database.password }}"
      database: "{{ backstage.database.name }}"
