name: Local Precision Setup
version: 1.0.0
schema: v1

models:
  - name: Qwen 2.5 Coder 14B (Chat)
    provider: ollama
    model: qwen2.5-coder-agent:14b
    roles:
      - chat
      - edit

  - name: Qwen 2.5 Coder 1.5B (Autocomplete)
    provider: ollama
    model: qwen2.5-coder:1.5b
    roles:
      - autocomplete
    autocompleteOptions:
      debounceDelay: 250
      maxPromptTokens: 1024
