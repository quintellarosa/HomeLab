---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: argocd-server-ingress
  namespace: {{ argocd_namespace }}
  annotations:
    cert-manager.io/cluster-issuer: {{ argocd_cert_manager_issuer }}
spec:
  ingressClassName: {{ argocd_ingress_class_name }}
  tls:
    - hosts:
        - {{ argocd_hostname }}
      secretName: {{ argocd_tls_secret_name }}
  rules:
    - host: {{ argocd_hostname }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: argocd-server
                port:
                  number: 80
