---
apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: {{ metallb_pool_name }}
  namespace: {{ metallb_namespace }}
spec:
  addresses:
    - {{ _metallb_resolved_pool }}
---
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: {{ metallb_l2_name }}
  namespace: {{ metallb_namespace }}
spec:
  ipAddressPools:
    - {{ metallb_pool_name }}
{% if _metallb_use_libvirt_nic | bool %}
  interfaces:
    - {{ _metallb_target_interface }}
{% endif %}
